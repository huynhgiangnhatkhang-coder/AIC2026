# Backend API base URL. Defaults to http://localhost:8000 (uvicorn).
# When set, the UI talks to the backend directly (CORS must allow this
# origin); otherwise the Vite dev proxy forwards /health, /info, /search/*
# and /submit to :8000.
VITE_API_BASE_URL=http://0.0.0.0:8000

# Optional: override where keyframe thumbnails are loaded from.
# The AIC2026 backend returns relative /frames/{video_id}/{frame_id} URLs,
# which the client prefixes with VITE_API_BASE_URL. Only set this when you
# serve keyframes from a different host (e.g. a MinIO/CDN) — host/port of
# the frame URL is then replaced.
# VITE_MEDIA_BASE_URL=http://localhost:9000

# Vite dev proxy target (only used when VITE_API_BASE_URL is unset).
# VITE_PROXY_TARGET=http://localhost:8000
